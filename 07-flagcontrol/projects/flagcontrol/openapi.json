{
  "openapi": "3.0.3",
  "info": {
    "title": "FlagControl",
    "version": "0.1.0",
    "description": "Feature flags; request examples and route contract. Exact required fields and invariants are validated by Go handlers."
  },
  "servers": [
    {
      "url": "http://localhost:8086"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/flags/{key}/{environment}": {
      "put": {
        "operationId": "flagcontrol_put_flags_key_environment",
        "summary": "PUT /flags/{key}/{environment}",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "environment",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found or transition not applicable"
          },
          "409": {
            "description": "Conflict"
          },
          "413": {
            "description": "Body exceeds 1 MiB"
          },
          "429": {
            "description": "Rate limit"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expected_version": {
                    "type": "integer"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "percentage": {
                    "type": "integer"
                  },
                  "allow_users": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "expected_version": 0,
                "enabled": true,
                "percentage": 50,
                "allow_users": []
              }
            }
          }
        }
      },
      "get": {
        "operationId": "flagcontrol_get_flags_key_environment",
        "summary": "GET /flags/{key}/{environment}",
        "security": [
          {
